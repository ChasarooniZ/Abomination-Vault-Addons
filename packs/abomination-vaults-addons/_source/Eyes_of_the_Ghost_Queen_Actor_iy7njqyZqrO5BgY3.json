	"items": [
		{
			"_id": "QrgnumULVnz8pWfK",
			"img": "https://assets.forge-vtt.com/bazaar/systems/pf2e/assets/icons/actions/Reaction.webp",
			"name": "Unmask Evil",
			"sort": 100000,
			"system": {
				"description": {
					"gm": "",
					"value": "<p><strong>Trigger</strong> Two or more creatures enter the haunt's area</p><hr /><p><strong>Effect</strong> Each creature sees the forms of nearby creatures shift and change, appearing to transform into fiendish or aberrant beings with a thirst for blood. Each creature in the area must attempt a @Check[type:will|dc:33] save. The haunt then rolls initiative.</p><hr /><p><strong>Critical Success</strong> The creature sees through the illusions entirely and is temporarily immune to the haunt's actions for 1 minute.</p><p><strong>Success</strong> The creature is unaffected by the strange images.</p><p><strong>Failure</strong> The creature believes the illusions to be true; when an action from the haunt inflicts @UUID[Compendium.pf2e.conditionitems.Item.yblD8fOR1J8rDwEQ]{Confused}, they do not attempt flat checks toe end the confused condition when they take damage.</p><p><strong>Critical Failure</strong> As failure, but the creature is left with a lingering suspicion of others and can't benefit from the @UUID[Compendium.pf2e.actionspf2e.Item.HCl3pzVefiv9ZKQW]{Aid} action for 24 hours.</p>"
				},
