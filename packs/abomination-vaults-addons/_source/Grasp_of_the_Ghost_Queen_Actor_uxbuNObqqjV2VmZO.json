	"items": [
		{
			"_id": "QrgnumULVnz8pWfK",
			"img": "https://assets.forge-vtt.com/bazaar/systems/pf2e/assets/icons/actions/Reaction.webp",
			"name": "Seize Control",
			"sort": 100000,
			"system": {
				"description": {
					"gm": "",
					"value": "<p>The haunt is quick to react when creatures enter its range.</p><section class=\"statblock\"><p><strong>Trigger</strong> Two or more creatures enter the haunt's area</p></section><hr /><section class=\"statblock\"><p><strong>Effect</strong> Each creature sees the forms of nearby creatures shift and change, appearing to transform into fiendish or aberrant beings with a thirst for blood. Each creature in the area must attempt a @Check[type:will|dc:35] save. The haunt then rolls initiative.</p></section><hr /><section class=\"statblock\"><p><strong>Success</strong> The creature is unaffected by the strange images.</p><p><strong>Failure</strong> The creature feels that death is close at hand and becomes @UUID[Compendium.pf2e.conditionitems.Item.3uh1r86TzbQvosxv]{Doomed 1}.</p><p><strong>Critical Failure</strong> As failure, and the creature is @UUID[Compendium.pf2e.conditionitems.Item.e1XGnhKNSQIm5IXg]{Stupefied 1} for 24 hours.</p></section>"
				},
