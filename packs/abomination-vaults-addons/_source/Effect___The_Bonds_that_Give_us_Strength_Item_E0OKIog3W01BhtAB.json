{
	"name": "Effect:  The Bonds that Give us Strength",
	"type": "effect",
	"effects": [],
	"system": {
		"description": {
			"gm": "",
			"value": "<p>The NPC aids in your check giving you either an untyped bonus of:</p><ul><li><p><strong>+1</strong> - Something the NPC wouldn't really be proficient in (IE Carman in Religion)</p></li><li><p><strong>+2</strong> - Something the NPC would be proficient in (IE Morliblint and Arcana)</p></li><li><p><strong>+3</strong> - If you share an especially close bond with the NPC (their presence inspires you)</p></li></ul>"
		},
